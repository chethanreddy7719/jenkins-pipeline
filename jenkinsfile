stages {
        stage('CHECKOUT') {
            steps {
                echo 'Building...'
                git branch: 'main', credentialsId: 'git_hub', url: 'https://github.com/chethanreddy7719/git-repo.git'
            }
        }
        stage('BUILD') {
            steps {
              git branch: 'main', credentialsId: 'git_hub', url: 'https://github.com/chethanreddy7719/git-repo.git'  
		sh '''
		pwd
              ls -lrt
		'''
            }
        }
    }
